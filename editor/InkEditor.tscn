[sub_resource type="GDScript" id="GDScript_aqlu3"]
script/source = "@tool
extends PopupMenu

enum id_list {
	NEW_FILE = 1,
	OPEN_FOLDER,
	IMPORT_FILE,
	EXPORT_FILE,
	SAVE_SESSION,
	DISCARD_SESSION,
}

var _is_mobile := false
var _pending_export_path := \"\"

func _ready():
	_is_mobile = OS.has_feature(\"mobile\") or OS.has_feature(\"android\") or OS.has_feature(\"ios\")

	clear(true)
	add_item(\"New File\", id_list.NEW_FILE)

	if _is_mobile:
		add_item(\"Import File...\", id_list.IMPORT_FILE)
		add_item(\"Export File...\", id_list.EXPORT_FILE)
	else:
		add_item(\"Open Folder\", id_list.OPEN_FOLDER)

	add_separator()
	add_item(\"Save Session\", id_list.SAVE_SESSION)
	add_item(\"Discard Session\", id_list.DISCARD_SESSION)

	id_pressed.connect(_on_id_pressed)

func _on_id_pressed(id: int):
	match id:
		id_list.NEW_FILE: new_file()
		id_list.OPEN_FOLDER: show_open_dialog()
		id_list.IMPORT_FILE: show_import_dialog()
		id_list.EXPORT_FILE: show_export_dialog()
		id_list.SAVE_SESSION: save_session()
		id_list.DISCARD_SESSION: discard_session()


#region New File

func new_file():
	var dir := _resolve_new_file_dir()
	if dir.is_empty():
		push_warning(\"[Inkodot]: No valid directory to create a file in.\")
		return
	%FileTree.open_new_file_dialog(dir)

func _resolve_new_file_dir() -> String:
	var tree_dir: String = %FileTree.get_selected_target_dir()
	if not tree_dir.is_empty() and DirAccess.dir_exists_absolute(tree_dir):
		return tree_dir

	var main: String = %CodeEdit.MainFolder
	if not main.is_empty() and DirAccess.dir_exists_absolute(main):
		return main

	return \"\"

#endregion


#region Session

func save_session():
	%CodeEdit.SaveSession()
	%FileTree.update_all_save_states()

func discard_session():
	%CodeEdit.DiscardSession()
	%FileTree.update_all_save_states()

#endregion


#region Desktop — Open Folder

## Desktop only. Opens the OS folder picker, starting at the current
## MainFolder. In standalone desktop mode this is the folder next to the
## executable; in plugin mode it's res://. Both absolute and res:// paths
## work.
func show_open_dialog():
	var start := %CodeEdit.MainFolder as String
	if not start or start.is_empty():
		start = \"res://\"

	DisplayServer.file_dialog_show(
		\"Open Folder\", start, \"\", false,
		DisplayServer.FILE_DIALOG_MODE_OPEN_DIR, [],
		_on_folder_chosen)

func _on_folder_chosen(status: bool, selected_paths: PackedStringArray, selected_filter_index: int):
	if not status: return
	var new_path := selected_paths[selected_filter_index]
	%CodeEdit.MainFolder = new_path
	%CodeEdit.SaveLastFolder()
	%FileTree.regenerate_tree()

#endregion


#region Mobile — Import / Export File

## Mobile only. Opens the OS file picker, restricted to .ink files, and
## copies the selected file into the workspace.
##
## On Android the picker returns a content:// URI, which Godot's FileAccess
## can read on 4.4+. The file's original location is irrelevant — we grab
## its bytes and write our own copy into <user_data>/ink/.
func show_import_dialog():
	DisplayServer.file_dialog_show(
		\"Import Ink File\",
		\"\", \".ink\", false,
		DisplayServer.FILE_DIALOG_MODE_OPEN_FILE,
		[\"*.ink\"],
		_on_import_file_chosen)

func _on_import_file_chosen(status: bool, selected_paths: PackedStringArray, _filter_index: int):
	if not status or selected_paths.is_empty(): return

	var src_uri := selected_paths[0]
	_copy_uri_into_workspace(src_uri)


## Copies the currently open file out to a location chosen by the user via
## the OS save dialog.
func show_export_dialog():
	var source := %CodeEdit.FilePath as String
	if not source or source.is_empty():
		push_warning(\"[Inkodot]: No file is currently open to export.\")
		return
	if not FileAccess.file_exists(source):
		push_warning(\"[Inkodot]: Source file no longer exists: %s\" % source)
		return

	_pending_export_path = source

	DisplayServer.file_dialog_show(
		\"Export Ink File\",
		\"\", source.get_file(), false,
		DisplayServer.FILE_DIALOG_MODE_SAVE_FILE,
		[\"*.ink\"],
		_on_export_file_chosen)

func _on_export_file_chosen(status: bool, selected_paths: PackedStringArray, _filter_index: int):
	var source := _pending_export_path
	_pending_export_path = \"\"

	if not status or selected_paths.is_empty(): return
	if source.is_empty(): return

	var dest_uri := selected_paths[0]

	var src := FileAccess.open(source, FileAccess.READ)
	if not src:
		push_warning(\"[Inkodot]: Could not read source: %s\" % source)
		return
	var bytes := src.get_buffer(src.get_length())
	src.close()

	var dst := FileAccess.open(dest_uri, FileAccess.WRITE)
	if not dst:
		push_warning(\"[Inkodot]: Could not write to destination: %s\" % dest_uri)
		return
	dst.store_buffer(bytes)
	dst.close()

	#print(\"[Inkodot]: Exported %s → %s\" % [source.get_file(), dest_uri])


## Reads the file behind `src_uri`, copies its bytes into the workspace
## folder, refreshes the tree, and selects the new entry.
##
## If a file with the same name already exists in the workspace, a numeric
## suffix is appended (\"name (2).ink\") rather than overwriting.
func _copy_uri_into_workspace(src_uri: String) -> bool:
	var src := FileAccess.open(src_uri, FileAccess.READ)
	if not src:
		push_warning(\"[Inkodot]: Could not open %s\" % src_uri)
		return false

	var bytes := src.get_buffer(src.get_length())
	src.close()

	var fname := _extract_filename_from_uri(src_uri)
	if not fname.ends_with(\".ink\"):
		fname += \".ink\"

	var dest_dir: String = %CodeEdit.MainFolder
	if dest_dir.is_empty() or not DirAccess.dir_exists_absolute(dest_dir):
		push_warning(\"[Inkodot]: Workspace folder is not available.\")
		return false

	var dest := dest_dir.path_join(fname)

	if FileAccess.file_exists(dest):
		var stem := fname.get_basename()
		var ext := fname.get_extension()
		var n := 2
		while FileAccess.file_exists(dest) and n <= 100:
			fname = \"%s (%d).%s\" % [stem, n, ext]
			dest = dest_dir.path_join(fname)
			n += 1

		if n > 100:
			push_warning(\"[Inkodot]: Too many files with that name already.\")
			return false

	var dst := FileAccess.open(dest, FileAccess.WRITE)
	if not dst:
		push_warning(\"[Inkodot]: Could not write to %s\" % dest)
		return false
	dst.store_buffer(bytes)
	dst.close()

	%FileTree.regenerate_tree()

	var new_item := %FileTree.find_item_by_path(dest) as TreeItem
	if new_item:
		new_item.select(0)

	#print(\"[Inkodot]: Imported %s → %s\" % [src_uri, dest])
	return true


## Extracts a plausible filename from a content:// or file:// URI. Falls
## back to \"imported.ink\" if nothing usable is found.
func _extract_filename_from_uri(uri: String) -> String:
	var u := uri.replace(\"\\\\\", \"/\")

	# Strip query parameters (SAF sometimes appends them).
	var q := u.find(\"?\")
	if q >= 0:
		u = u.substr(0, q)

	var slash := u.rfind(\"/\")
	var name := u.substr(slash + 1) if slash >= 0 else u

	name = name.uri_decode()

	# SAF \"document IDs\" can be long hashes with no extension — reject those
	# and let the caller fall back.
	if name.length() > 128 or name.is_empty():
		name = \"imported.ink\"

	return name

#endregion
"

