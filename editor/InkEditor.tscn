[sub_resource type="GDScript" id="GDScript_cevi5"]
script/source = "@tool
extends Tree

@export var hide_empty := true

var popup_menu: PopupMenu
var _new_file_target_dir := \"\"
var _new_folder_target_dir := \"\"
var _rename_file_original_path := \"\"
var _rename_folder_original_path := \"\"
var _pending_delete_action: Callable = Callable()

enum types { DIR, FILE }

enum id_list { 
	DISCARD = 1, 
	SAVE, 
	DELETE_FILE, 
	NEW_FILE,
	NEW_FOLDER,
	RENAME_FILE,
	RENAME_FOLDER,
	DELETE_FOLDER,
	EXPAND_ALL,
	EXPAND_ONE_LEVEL,
	COLLAPSE_CHILDREN,
	COLLAPSE_ALL,
}

func _ready():
	## Tree signals
	item_selected.connect(_on_selected)
	item_collapsed.connect(_on_collapsed)
	%CodeEdit.text_changed.connect(func(): check_save_status(get_selected()))

	## New File / New Folder popups
	%CreateNewFileButton.pressed.connect(_on_create_new_file_pressed)
	%CreateNewFolderButton.pressed.connect(_on_create_new_folder_pressed)
	%CreateNewFileLineEdit.text_changed.connect(_refresh_new_file_button_state)
	%CreateNewFolderLineEdit.text_changed.connect(_refresh_new_folder_button_state)

	## Rename popups
	%RenameFileButton.pressed.connect(_on_rename_file_pressed)
	%RenameFolderButton.pressed.connect(_on_rename_folder_pressed)
	%RenameFileLineEdit.text_changed.connect(_refresh_rename_file_button_state)
	%RenameFolderLineEdit.text_changed.connect(_refresh_rename_folder_button_state)

	## Shared delete-confirmation dialog
	%DeleteConfirmationDialog.confirmed.connect(_on_delete_dialog_confirmed)
	%DeleteConfirmationDialog.visibility_changed.connect(_on_delete_dialog_visibility_changed)

	# Initial state — buttons should start disabled.
	_refresh_new_file_button_state()
	_refresh_new_folder_button_state()
	_refresh_rename_file_button_state()
	_refresh_rename_folder_button_state()

	# Defer: the parent InkEditor sets MainFolder in its own _Ready(), which
	# runs *after* this one. Waiting one frame lets us read the final value.
	regenerate_tree.call_deferred()

	%CodeEdit.SaveStateModified.connect(update_all_save_states)

func regenerate_tree():
	var root_dir = %CodeEdit.MainFolder
	clear()
	add_nested_dir(root_dir, null)

func update_all_save_states():
	var root = get_root()
	await check_save_state_recursive(root)

func check_save_state_recursive(item: TreeItem):
	var children := item.get_children()
	
	for child in children:
		if not child: continue
		if child is not TreeItem: continue
		
		if child.get_metadata(0)[\"type\"] == types.FILE: 
			check_save_status(child)
		
		check_save_state_recursive(child)
		await get_tree().process_frame

func add_nested_dir(dir: String, parent_item: TreeItem):
	var directories = DirAccess.get_directories_at(dir)
	var files = DirAccess.get_files_at(dir)
	
	var item: TreeItem
	
	if parent_item:
		item = parent_item.create_child()
	else:
		item = create_item()
	
	item.set_metadata(0, {\"path\": dir, \"type\": types.DIR})
	item.set_text(0, \"📁%s\" % dir.get_file())
	
	for _dir in directories: add_nested_dir(dir.path_join(_dir), item)
	
	for file in files: add_file(dir.path_join(file), item)
	
	_on_collapsed(item)
	
	if hide_empty and item.get_child_count() == 0: 
		item.free()

func add_file(file: String, parent_item: TreeItem):
	if not file.ends_with(\".ink\"): return
	var item: TreeItem
	if parent_item:
		item = parent_item.create_child()
	else:
		item = create_item()
	
	item.set_metadata(0, {\"path\": file, \"type\": types.FILE})
	item.set_text(0, \"📄%s\" % file.get_file())
	check_save_status(item)

func _on_selected():
	var item := get_selected()
	if not is_instance_valid(item): return
	var path: String = item.get_metadata(0)[\"path\"]
	
	if not path: return
	if path.ends_with(\".ink\"):
		%CodeEdit.SetNewFile(path)
		%Title.text = path.get_file()
		check_save_status(item)

func _on_collapsed(item: TreeItem):
	var text = item.get_text(0)
	
	if not text.begins_with(\"📁\") and not text.begins_with(\"📂\"): return
	
	if (item.is_any_collapsed() or item.get_child_count() == 0):
		item.set_text(0, text.replace(\"📂\", \"📁\"))
	else:
		item.set_text(0, text.replace(\"📁\", \"📂\"))

func check_save_status(item: TreeItem):
	if not is_instance_valid(item): return
	var path: String = item.get_metadata(0)[\"path\"]
	
	if not FileAccess.file_exists(path):
		item.free()
		return
	
	var is_changed := %CodeEdit.IsFileChanged(path) as bool
	if is_changed:
		item.set_text(0, \"📝 ~%s\" % path.get_file())
		item.set_custom_color(0, Color.WHITE)
	else:
		item.set_text(0, \"📝 %s\" % path.get_file())
		item.set_custom_color(0, Color.GRAY)


#region Selection

## Clears the current tree selection. Emits nothing on its own —
## callers that need to react should check `get_selected()` afterwards.
func clear_selection() -> void:
	deselect_all()

#endregion


#region Folding

## Recursively sets `collapsed` on `item` and every descendant, refreshing
## each folder's 📁/📂 icon as it goes.
func _set_subtree_collapsed(item: TreeItem, collapsed: bool) -> void:
	item.collapsed = collapsed
	_on_collapsed(item)
	for child in item.get_children():
		_set_subtree_collapsed(child, collapsed)

## Opens `item`, collapses only its direct children. Deeper descendants
## keep whatever collapsed-state they had previously.
func _expand_one_level(item: TreeItem) -> void:
	item.collapsed = false
	_on_collapsed(item)
	for child in item.get_children():
		child.collapsed = true
		_on_collapsed(child)

## Keeps `item` open, recursively collapses everything below it.
func _collapse_children(item: TreeItem) -> void:
	item.collapsed = false
	_on_collapsed(item)
	for child in item.get_children():
		_set_subtree_collapsed(child, true)

#endregion


#region Keyboard Shortcuts

func _unhandled_key_input(event: InputEvent) -> void:
	if not (event is InputEventKey) or not event.pressed or event.echo:
		return

	# --- Escape : Clear selection ---
	if event.keycode == KEY_ESCAPE and not event.ctrl_pressed \\
			and not event.alt_pressed and not event.shift_pressed:
		if get_selected():
			clear_selection()
			get_viewport().set_input_as_handled()
		return

	# --- Ctrl+S : Save currently selected file ---
	if event.ctrl_pressed and event.keycode == KEY_S:
		var path := get_selected_file_path()
		if path.is_empty():
			push_warning(\"[Ink Editor]: No .ink file selected to save.\")
		else:
			%CodeEdit.WriteFile(path)
			check_save_status(get_selected())
		get_viewport().set_input_as_handled()
		return

	# --- Ctrl+N : New file in selected dir (or parent dir of selected file) ---
	if event.ctrl_pressed and event.keycode == KEY_N:
		var dir := get_selected_target_dir()
		if dir.is_empty():
			push_warning(\"[Ink Editor]: No valid directory selected.\")
		else:
			open_new_file_dialog(dir)
		get_viewport().set_input_as_handled()
		return

#endregion


#region Selection Helpers

## Returns the path of the selected item if it's a .ink file, otherwise \"\".
func get_selected_file_path() -> String:
	var item := get_selected()
	if not is_instance_valid(item): return \"\"
	
	var meta: Dictionary = item.get_metadata(0)
	if not meta or meta[\"type\"] != types.FILE: return \"\"
	
	var path := meta[\"path\"] as String
	if not path.ends_with(\".ink\"): return \"\"
	return path

## Returns the directory new files should go into based on current selection:
##  - DIR  -> that directory
##  - FILE -> its parent directory
##  - none -> MainFolder
func get_selected_target_dir() -> String:
	var item := get_selected()
	
	if not is_instance_valid(item):
		return %CodeEdit.MainFolder
	
	var meta: Dictionary = item.get_metadata(0)
	if not meta: return %CodeEdit.MainFolder
	
	var path := meta[\"path\"] as String
	
	if meta[\"type\"] == types.DIR:
		return path
	if meta[\"type\"] == types.FILE:
		return path.get_base_dir()
	
	return %CodeEdit.MainFolder

## Returns true if `child_path` lies strictly under `parent_dir`.
func _is_path_under(child_path: String, parent_dir: String) -> bool:
	if child_path.is_empty() or parent_dir.is_empty(): return false
	return child_path.begins_with(parent_dir.rstrip(\"/\") + \"/\")

#endregion


#region Name Validation

## Shared validator. `original_path` is \"\" for create, or the pre-rename
## path (a same-name rename is treated as unchanged and rejected with a
## friendly message). `ext` is \"\" for folders, \".ink\" for files.
func _describe_name_problem(
		raw_name: String,
		dir: String,
		ext: String,
		original_path: String = \"\"
	) -> String:

	var name := raw_name.strip_edges()
	if name.is_empty():
		return \"Enter a name.\"

	if not name.is_valid_filename():
		return \"Name contains invalid characters.\"

	if dir.is_empty() or not DirAccess.dir_exists_absolute(dir):
		return \"Target folder does not exist.\"

	var target := dir.path_join(name)
	if not ext.is_empty() and not target.ends_with(ext):
		target += ext

	if not original_path.is_empty() and target == original_path:
		return \"Name is unchanged.\"

	if FileAccess.file_exists(target):
		return \"A file named \\\"%s\\\" already exists here.\" % target.get_file()
	if DirAccess.dir_exists_absolute(target):
		return \"A folder named \\\"%s\\\" already exists here.\" % target.get_file()

	return \"\"

## Applies a problem string to a button + optional warning label.
## Returns true if there was no problem (button enabled).
func _apply_validation_problem(problem: String, button: Button, warning_label: Label) -> bool:
	var ok := problem.is_empty()
	button.disabled = not ok

	if is_instance_valid(warning_label):
		warning_label.text = problem
		warning_label.visible = not ok

	return ok

#endregion


#region New File / Folder / Rename Validation Refresh

func _refresh_new_file_button_state(_new_text: String = \"\") -> void:
	_apply_validation_problem(
		_describe_name_problem(%CreateNewFileLineEdit.text, _new_file_target_dir, \".ink\"),
		%CreateNewFileButton,
		get_node_or_null(^\"%NewFileWarning\") as Label)

func _refresh_new_folder_button_state(_new_text: String = \"\") -> void:
	_apply_validation_problem(
		_describe_name_problem(%CreateNewFolderLineEdit.text, _new_folder_target_dir, \"\"),
		%CreateNewFolderButton,
		get_node_or_null(^\"%NewFolderWarning\") as Label)

func _refresh_rename_file_button_state(_new_text: String = \"\") -> void:
	_apply_validation_problem(
		_describe_name_problem(
			%RenameFileLineEdit.text,
			_rename_file_original_path.get_base_dir(),
			\".ink\",
			_rename_file_original_path),
		%RenameFileButton,
		get_node_or_null(^\"%RenameFileWarning\") as Label)

func _refresh_rename_folder_button_state(_new_text: String = \"\") -> void:
	_apply_validation_problem(
		_describe_name_problem(
			%RenameFolderLineEdit.text,
			_rename_folder_original_path.get_base_dir(),
			\"\",
			_rename_folder_original_path),
		%RenameFolderButton,
		get_node_or_null(^\"%RenameFolderWarning\") as Label)

#endregion


#region Popup Openers

func open_new_file_dialog(dir: String) -> void:
	_new_file_target_dir = dir
	_refresh_new_file_button_state()
	%NewFilePopup.popup_centered()

func open_new_folder_dialog(dir: String) -> void:
	_new_folder_target_dir = dir
	_refresh_new_folder_button_state()
	%NewFolderPopup.popup_centered()

func open_rename_file_dialog(path: String) -> void:
	_rename_file_original_path = path
	%RenameFileLineEdit.text = path.get_file().get_basename()
	_refresh_rename_file_button_state()
	%RenameFilePopup.popup_centered()

func open_rename_folder_dialog(path: String) -> void:
	_rename_folder_original_path = path
	%RenameFolderLineEdit.text = path.get_file()
	_refresh_rename_folder_button_state()
	%RenameFolderPopup.popup_centered()

func _on_create_new_file_pressed() -> void:
	create_new_file(_new_file_target_dir)

func _on_create_new_folder_pressed() -> void:
	create_new_folder(_new_folder_target_dir)

func _on_rename_file_pressed() -> void:
	rename_file(_rename_file_original_path)

func _on_rename_folder_pressed() -> void:
	rename_folder(_rename_folder_original_path)

#endregion


#region Context Menu (right-click)

## Adds a popup entry to `menu` whose click handler runs `action`.
func _add_action_to(menu: PopupMenu, label: String, id: int, action: Callable) -> void:
	menu.add_item(label, id)
	menu.id_pressed.connect(
		func(pressed_id: int):
			if pressed_id == id:
				action.call()
	)

## Builds a \"Folding\" submenu parented under `popup_menu`, targeting `item`.
func _add_folding_submenu(item: TreeItem) -> void:
	var fold_menu := PopupMenu.new()
	popup_menu.add_child(fold_menu)                 # required before add_submenu_node_item
	popup_menu.add_submenu_node_item(\"Folding\", fold_menu)

	_add_action_to(fold_menu, \"Expand All\", id_list.EXPAND_ALL,
		func(): _set_subtree_collapsed(item, false))

	_add_action_to(fold_menu, \"Expand One Level\", id_list.EXPAND_ONE_LEVEL,
		func(): _expand_one_level(item))

	fold_menu.add_separator()

	_add_action_to(fold_menu, \"Collapse Children\", id_list.COLLAPSE_CHILDREN,
		func(): _collapse_children(item))

	_add_action_to(fold_menu, \"Collapse All\", id_list.COLLAPSE_ALL,
		func(): _set_subtree_collapsed(item, true))

## Shared entries for both \"create in a directory\" cases (empty space → MainFolder,
## or right-click on a folder). Keeps the two code paths in sync.
func _add_create_entries(target_dir: String) -> void:
	_add_action_to(popup_menu, \"New File\", id_list.NEW_FILE,
		func(): open_new_file_dialog(target_dir))

	_add_action_to(popup_menu, \"New Folder\", id_list.NEW_FOLDER,
		func(): open_new_folder_dialog(target_dir))

func _gui_input(event: InputEvent) -> void:
	if not (event is InputEventMouseButton): return
	if not event.pressed: return

	# --- Left click on empty space: clear selection ---
	if event.button_index == MOUSE_BUTTON_LEFT:
		if get_item_at_position(event.position) == null and get_selected():
			clear_selection()
		return

	# --- Right click: context menu ---
	if event.button_index != MOUSE_BUTTON_RIGHT: return

	var item = get_item_at_position(event.position)
	restart_popup()

	# Right-clicked empty space — offer create entries at MainFolder.
	if item == null:
		var root_dir: String = %CodeEdit.MainFolder
		if root_dir.is_empty() or not DirAccess.dir_exists_absolute(root_dir):
			return

		_add_create_entries(root_dir)
		popup_menu.popup_on_parent(Rect2(event.global_position, Vector2.ZERO))
		return

	# Select what we right-clicked, so all subsequent actions act on it
	item.select(0)

	var meta: Dictionary = item.get_metadata(0)
	if not meta: return
	var path := meta[\"path\"] as String

	if meta[\"type\"] == types.DIR:
		if not DirAccess.dir_exists_absolute(path): return

		_add_create_entries(path)

		popup_menu.add_separator()
		_add_action_to(popup_menu, \"Rename Folder\", id_list.RENAME_FOLDER,
			func(): open_rename_folder_dialog(path))

		popup_menu.add_separator()
		_add_folding_submenu(item)

		popup_menu.add_separator()
		_add_action_to(popup_menu, \"Delete Folder\", id_list.DELETE_FOLDER,
			func(): _confirm_delete_folder(path))

		# Deleting / renaming the root folder would break MainFolder — hide both.
		if path == %CodeEdit.MainFolder:
			popup_menu.set_item_disabled(
				popup_menu.get_item_index(id_list.DELETE_FOLDER), true)
			popup_menu.set_item_disabled(
				popup_menu.get_item_index(id_list.RENAME_FOLDER), true)

	if meta[\"type\"] == types.FILE:
		var is_changed := %CodeEdit.IsFileChanged(path) as bool

		## Save
		popup_menu.add_item(\"Save Changes\", id_list.SAVE)
		popup_menu.set_item_disabled(popup_menu.get_item_index(id_list.SAVE), not is_changed)
		popup_menu.id_pressed.connect(func(id): if (id == id_list.SAVE): %CodeEdit.WriteFile(path); check_save_status(item))

		## Discard
		popup_menu.add_item(\"Discard Changes\", id_list.DISCARD)
		popup_menu.set_item_disabled(popup_menu.get_item_index(id_list.DISCARD), not is_changed)
		popup_menu.id_pressed.connect(func(id): if (id == id_list.DISCARD): %CodeEdit.RemoveFromCache(path); check_save_status(item))

		## Rename
		popup_menu.add_separator()
		_add_action_to(popup_menu, \"Rename File\", id_list.RENAME_FILE,
			func(): open_rename_file_dialog(path))

		## Delete
		_add_action_to(popup_menu, \"Delete File\", id_list.DELETE_FILE,
			func(): _confirm_delete_file(path))

	popup_menu.popup_on_parent(Rect2(event.global_position, Vector2.ZERO))

#endregion


#region Deletion

## Runs `action` on the next `confirmed` from the shared dialog.
## Any previous pending action (from a cancelled dialog) is discarded.
func _confirm_then(action: Callable) -> void:
	_pending_delete_action = action
	%DeleteConfirmationDialog.popup_centered()

func _confirm_delete_file(path: String) -> void:
	_confirm_then(func(): _delete_file(path))

func _confirm_delete_folder(path: String) -> void:
	_confirm_then(func(): _delete_folder(path))

func _on_delete_dialog_confirmed() -> void:
	var action := _pending_delete_action
	_pending_delete_action = Callable()
	if action.is_valid():
		action.call()

func _on_delete_dialog_visibility_changed() -> void:
	if %DeleteConfirmationDialog.visible: return
	# AcceptDialog::_ok_pressed calls hide() *before* emitting `confirmed`,
	# so we must defer clearing the pending action by one frame — otherwise
	# the synchronous clear would kill the action before `confirmed` runs.
	_clear_pending_delete_deferred.call_deferred()

func _clear_pending_delete_deferred() -> void:
	_pending_delete_action = Callable()

func _delete_file(path: String) -> void:
	# Remove any pending edits first — otherwise SaveSession would write the
	# file back to disk on the next run.
	%CodeEdit.RemoveFromCache(path)

	var err := DirAccess.remove_absolute(path)
	if err != OK:
		push_warning(\"[Ink Editor]: Could not delete %s (error %d).\" % [path, err])
		return

	# If the currently-open file is the one we just deleted, clear the editor.
	if %CodeEdit.FilePath == path:
		%CodeEdit.ClearFile()

	regenerate_tree()

func _delete_folder(path: String) -> void:
	if path.is_empty(): return
	if not DirAccess.dir_exists_absolute(path): return
	if path == %CodeEdit.MainFolder:
		push_warning(\"[Ink Editor]: Refusing to delete the main folder.\")
		return

	_purge_save_cache_under(path)

	var err := OS.move_to_trash(ProjectSettings.globalize_path(path))
	if err != OK:
		push_warning(\"[Ink Editor]: Could not move folder to trash: %s (error %d).\" % [path, err])
		return

	var current: String = %CodeEdit.FilePath
	if not current.is_empty() and _is_path_under(current, path):
		%CodeEdit.ClearFile()

	regenerate_tree()

## Drops any StoriesSaveCache entries whose path begins with `folder_path/`.
func _purge_save_cache_under(folder_path: String) -> void:
	var prefix := folder_path.rstrip(\"/\") + \"/\"
	var cache: Dictionary = %CodeEdit.StoriesSaveCache

	var to_remove: Array = []
	for key in cache.keys():
		if (key as String).begins_with(prefix):
			to_remove.append(key)

	for key in to_remove:
		cache.erase(key)

#endregion


#region Rename

func rename_file(old_path: String) -> void:
	var new_name := (%RenameFileLineEdit.text as String).strip_edges()
	if new_name.is_empty(): return

	var dir := old_path.get_base_dir()
	var new_path := dir.path_join(new_name)
	if not new_path.ends_with(\".ink\"): new_path += \".ink\"

	if new_path == old_path:
		%RenameFilePopup.hide()
		return

	var err := DirAccess.rename_absolute(old_path, new_path)
	if err != OK:
		push_warning(\"[Ink Editor]: Could not rename %s (error %d).\" % [old_path, err])
		return

	# Remap the cache entry if the old path had unsaved edits.
	var cache: Dictionary = %CodeEdit.StoriesSaveCache
	if cache.has(old_path):
		var cached = cache[old_path]
		cache.erase(old_path)
		cache[new_path] = cached

	# If this file is open, repoint the editor at its new home.
	if %CodeEdit.FilePath == old_path:
		%CodeEdit.FilePath = new_path
		%Title.text = new_path.get_file()

	%RenameFilePopup.hide()
	regenerate_tree()

func rename_folder(old_path: String) -> void:
	var new_name := (%RenameFolderLineEdit.text as String).strip_edges()
	if new_name.is_empty(): return

	var parent := old_path.get_base_dir()
	var new_path := parent.path_join(new_name)

	if new_path == old_path:
		%RenameFolderPopup.hide()
		return

	var err := DirAccess.rename_absolute(old_path, new_path)
	if err != OK:
		push_warning(\"[Ink Editor]: Could not rename folder %s (error %d).\" % [old_path, err])
		return

	# Remap every cache entry under the old prefix.
	_remap_save_cache_under(old_path, new_path)

	# If the currently-open file lived under the old folder, remap its path too.
	var current: String = %CodeEdit.FilePath
	if not current.is_empty() and _is_path_under(current, old_path):
		var relative := current.substr(old_path.length())
		var new_current := new_path + relative
		%CodeEdit.FilePath = new_current
		%Title.text = new_current.get_file()

	%RenameFolderPopup.hide()
	regenerate_tree()

## Moves every StoriesSaveCache key under `old_folder/` to `new_folder/...`.
func _remap_save_cache_under(old_folder: String, new_folder: String) -> void:
	var old_prefix := old_folder.rstrip(\"/\") + \"/\"
	var new_prefix := new_folder.rstrip(\"/\") + \"/\"
	var cache: Dictionary = %CodeEdit.StoriesSaveCache

	# Snapshot keys first — we're mutating the dict inside the loop.
	var to_remap: Array = []
	for key in cache.keys():
		if (key as String).begins_with(old_prefix):
			to_remap.append(key)

	for key in to_remap:
		var value = cache[key]
		cache.erase(key)
		var new_key: String = new_prefix + (key as String).substr(old_prefix.length())
		cache[new_key] = value

#endregion


#region File & Folder Creation

func create_new_file(parent_dir: String):
	var new_name := (%CreateNewFileLineEdit.text as String).strip_edges()
	if new_name.is_empty(): return

	var new_path := parent_dir.path_join(new_name)
	if not new_path.ends_with(\".ink\"): new_path += \".ink\"

	if FileAccess.file_exists(new_path):
		push_warning(\"[Ink Editor]: %s already exists!\" % new_path)
		return

	var file = FileAccess.open(new_path, FileAccess.WRITE)
	file.store_string(\"\")
	file.close()

	%NewFilePopup.hide()

	regenerate_tree()

	var new_item := find_item_by_path(new_path)
	if new_item:
		new_item.select(0)
		scroll_to_item(new_item)
	else:
		%CodeEdit.SetNewFile(new_path)
		%Title.text = new_path.get_file()

func create_new_folder(parent_dir: String):
	var new_name := (%CreateNewFolderLineEdit.text as String).strip_edges()
	if new_name.is_empty(): return

	var new_path := parent_dir.path_join(new_name)

	var err := DirAccess.make_dir_absolute(new_path)
	if err != OK:
		push_warning(\"[Ink Editor]: Could not create folder %s (error %d).\" % [new_path, err])
		return

	%NewFolderPopup.hide()

	regenerate_tree()

	var new_item := find_item_by_path(new_path)
	if new_item:
		new_item.select(0)
		scroll_to_item(new_item)

func restart_popup():
	if popup_menu: popup_menu.queue_free()
	popup_menu = PopupMenu.new(); add_child(popup_menu)

#endregion


#region Tree Lookup

func find_item_by_path(path: String) -> TreeItem:
	var root := get_root()
	if not root: return null
	return _find_item_recursive(root, path)

func _find_item_recursive(item: TreeItem, path: String) -> TreeItem:
	var meta = item.get_metadata(0)
	if meta is Dictionary and meta.get(\"path\", \"\") == path:
		return item

	for child in item.get_children():
		var found := _find_item_recursive(child, path)
		if found: return found

	return null

#endregion
"

[sub_resource type="GDScript" id="GDScript_yj2lj"]
script/source = "@tool
extends Tree

var ink_syntax

func _ready():
	hide_root = true
	update()
	%CodeEdit.OnTextUpdated.connect(update)
	ink_syntax = %CodeEdit.syntax_highlighter
	item_selected.connect(_on_select)

func update():
	clear()
	create_item()
	var heading_regex := RegEx.create_from_string(\"^[\\\\s]*=+\\\\K.*$\")
	var last_knot: TreeItem = null
	for num in %CodeEdit.get_line_count():
		var line := %CodeEdit.get_line(num) as String
		if heading_regex.search(line) == null:
			continue

		var stripped_line := line.strip_edges().strip_escapes()
		var item_text := stripped_line.replace(\"=\", \"\")

		if stripped_line.begins_with(\"===\"):
			# --- Knot: top-level, becomes the new parent for following stitches
			item_text = \"➤\" + item_text
			var item := get_root().create_child()
			item.set_custom_color(0, ink_syntax.knot_color)
			item.set_text(0, item_text)
			item.set_metadata(0, num)
			last_knot = item

		else:
			# --- Stitch: nested under the last knot if one exists, else at root
			item_text = \"⤷\" + item_text
			var item: TreeItem
			if last_knot != null:
				item = last_knot.create_child()
			else:
				item = get_root().create_child()
			item.set_custom_color(0, ink_syntax.stitch_color)
			item.set_text(0, item_text)
			item.set_metadata(0, num)

func _on_select():
	var item := get_selected()
	if item == null: return
	var num = item.get_metadata(0)
	if num == null: return
	%CodeEdit.grab_focus()
	%CodeEdit.set_caret_line(num)
	var scroll = %CodeEdit.get_v_scroll_bar()
	scroll.value = %CodeEdit.get_scroll_pos_for_line(num)
	deselect_all()
"

[sub_resource type="GDScript" id="GDScript_767nh"]
resource_name = "RestartButton"
script/source = "@tool
extends Button

func _ready():
	pressed.connect(
			func(): 
				%Dialogue.restart()
				await get_tree().process_frame
				%Dialogue.get_child(0).scroll_vertical = 0
				);
"

[sub_resource type="GDScript" id="GDScript_66xdl"]
resource_name = "BackButton"
script/source = "@tool
extends Button

func _ready():
	pressed.connect(_on_pressed);

func _on_pressed():
	var choices: PackedInt32Array = %CodeEdit.GetChoiceHistory()
	var dialogue := %Dialogue as Control
	
	if (choices.size() == 0): 
		return
	
	if (choices.size() == 1):
		dialogue.restart()
		return
	
	choices.remove_at(choices.size() - 1)
	%CodeEdit.SetChoiceHistory(choices)
	
	dialogue.story.reset_runtime_state()
	await get_tree().process_frame
	dialogue.load_choices(dialogue.story, choices)
"

