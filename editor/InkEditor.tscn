[sub_resource type="GDScript" id="GDScript_yapq3"]
script/source = "@tool
extends RichTextLabel

@export var code_edit: CodeEdit


func _ready():
	bbcode_enabled = true
	meta_clicked.connect(_on_meta_clicked)
	meta_hover_started.connect(_on_meta_hover_started)
	meta_hover_ended.connect(_on_meta_hover_ended)

	if not code_edit:
		return
	code_edit.OnTextUpdated.connect(_on_text_updated)
	_on_text_updated()


func _on_text_updated():
	clear()
	if not code_edit:
		return

	var errors: Dictionary = code_edit.Errors
	for line in _sorted_keys(errors):
		append_text(_format_entry(line, errors[line], \"red\"))

	var warnings: Dictionary = code_edit.Warnings
	for line in _sorted_keys(warnings):
		append_text(_format_entry(line, warnings[line], \"yellow\"))


## Builds one clickable line: \"20: Divert target not found\".
## The meta payload of the [url] is the 1-based line number, which
## _on_meta_clicked decodes and hands off to the code editor.
func _format_entry(line: int, message: String, color: String) -> String:
	var safe_msg := _escape_bbcode(message)
	return \"[url=%d][color=%s][b]%d[/b]: %s[/color][/url]\\n\" % [
		line, color, line, safe_msg]


## Literal `[` in an ink message would otherwise be parsed as BBCode.
func _escape_bbcode(s: String) -> String:
	return s.replace(\"[\", \"[lb]\")


func _sorted_keys(dict: Dictionary) -> Array:
	var keys := dict.keys()
	keys.sort()
	return keys


#region Click handling

func _on_meta_clicked(meta: Variant) -> void:
	var line := int(str(meta))
	if line <= 0:
		return
	_goto_line(line)


func _on_meta_hover_started(_meta: Variant) -> void:
	mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND


func _on_meta_hover_ended(_meta: Variant) -> void:
	mouse_default_cursor_shape = Control.CURSOR_ARROW


## Jumps the caret to the given 1-based line in the code editor.
## Errors dictionary stores 1-based line numbers, CodeEdit uses 0-based.
func _goto_line(one_based_line: int) -> void:
	if not is_instance_valid(code_edit):
		return

	var zero_based := clampi(one_based_line - 1, 0, code_edit.get_line_count() - 1)

	code_edit.grab_focus()
	code_edit.set_caret_line(zero_based)
	code_edit.set_caret_column(0)
	code_edit.center_viewport_to_caret()

#endregion
"

[sub_resource type="GDScript" id="GDScript_e8xbx"]
script/source = "@tool 
extends RichTextLabel

@export var code_edit: CodeEdit

func _ready():
	if not code_edit: return
	code_edit.OnTextUpdated.connect(_on_text_updated)
	_on_text_updated()

func _on_text_updated():
	text = \"\"
	if not code_edit: return
	if not code_edit.text: return
	
	var ink_text =  code_edit.text
	
	## Lines
	append_text(\"Lines: %s\" % code_edit.get_line_count())
	
	## Words
	append_text(\", \")
	var word_regex := RegEx.create_from_string(\"\\\\w\")
	var words = word_regex.search_all(ink_text)
	append_text(\"Words: %s\" % words.size())
	
	## Knots
	append_text(\", \")
	var knot_regex := RegEx.create_from_string(\"(?m)^[\\\\s]*===.*$\")
	var knots = knot_regex.search_all(ink_text)
	append_text(\"Knots: %s\" % knots.size())
	
	## Stitches
	append_text(\", \")
	var stitch_regex := RegEx.create_from_string(\"(?m)^(?!\\\\s*==)\\\\h*?=.*$\")
	var stitches = stitch_regex.search_all(ink_text)
	append_text(\"Stitches: %s\" % stitches.size())
	
	## Errors
	var errors := %CodeEdit.Errors as Dictionary
	if not errors.is_empty():
		append_text(\", \")
		append_text(\"[color=red]Errors: %s[/color]\" % errors.size())
	
	## Warnings
	var warnings := %CodeEdit.Warnings as Dictionary
	if not warnings.is_empty():
		append_text(\", \")
		append_text(\"[color=yellow]Warnings: %s[/color]\" % warnings.size())
"

