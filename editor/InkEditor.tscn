[sub_resource type="GDScript" id="GDScript_207ca"]
script/source = "@tool
extends CheckBox

@export var file_tree: Tree

func _ready() -> void:
	set_pressed_no_signal(file_tree.hide_empty)

func _toggled(toggled_on: bool) -> void:
	file_tree.hide_empty = toggled_on
	file_tree.regenerate_tree()
"

